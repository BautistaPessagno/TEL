fn classify n:int -> int
    total:int = 0
    if n < 0
        ret -1
    elif n == 0
        total = 1
    else
        total = 2
    ford i 0 n
        if i == 2
            cnt
        total += i
    while n > 0
        n--
    dw
        total++
    (total < 3)
    switch n
        0 ->
            total = 10
        1 ->
            total = 20
        default break
    ret total
