int classify(int n);

int classify(int n) {
    int total = 0;
    for (int i = 0; (i < n); (i++)) {
        (total += i);
    }
    int i = 0;
    for ((i = 0); (i < n); (i++)) {
        (total += 1);
    }
    while ((total > 0)) {
        (total -= 1);
    }
    do {
        (total += 1);
    } while ((total < n));
    switch (n) {
        case 0: {
            (total = 0);
            break;
        }
        case 1: {
            (total += 1);
            break;
        }
        default: {
            break;
        }
    }
    return total;
}

