fn classify n:int -> int
    total:int = 0
    ford i 0 n
        total += i
    i:int = 0
    for i = 0, i < n, i++
        total += 1
    while total > 0
        total -= 1
    dw
        total += 1
    (total < n)
    switch n
        0:
            total = 0
            break
        1:
            total += 1
            break
        default break
    ret total
