`
#include <stdio.h>
`

fn safe board:int[] row:int col:int -> int
    ford i 0 row
        q:int = board[i]
        if q == col
            ret 0
        d:int = row - i
        if q - col == d
            ret 0
        if col - q == d
            ret 0
    ret 1

fn solve board:int[] row:int n:int -> int
    if row == n
        ret 1
    count:int = 0
    ford col 0 n
        if safe(board, row, col)
            board[row] = col
            count += solve(board, row + 1, n)
    ret count

main
    board:int[8] = {0 0 0 0 0 0 0 0}
    total:int = solve(board, 0, 8)
    `
    printf("%d\n", total);
    `
    ret total
