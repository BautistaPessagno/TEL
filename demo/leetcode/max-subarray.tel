// LeetCode 53: Maximum Subarray (Kadane's algorithm)
#include stdio

fn maxSubArray a:int[] size:int -> int
    best:int = a[0]
    cur:int = a[0]
    ford i 1 size
        if cur + a[i] > a[i]
            cur = cur + a[i]
        else
            cur = a[i]
        if cur > best
            best = cur
    ret best

main
    // NOTE: a negative literal inside a space-separated array literal
    // ({-2 1 -3 ...}) is currently miscompiled ("1 -3" folds into "1 - 3"),
    // so the array is filled element by element instead.
    a:int[9]
    a[0] = -2
    a[1] = 1
    a[2] = -3
    a[3] = 4
    a[4] = -1
    a[5] = 2
    a[6] = 1
    a[7] = -5
    a[8] = 4
    printf("max subarray = %d\n", maxSubArray(a, 9))
    ret 0
