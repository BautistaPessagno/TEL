// LeetCode 704: Binary Search over a sorted array
#include stdio

fn binarySearch a:int[] size:int target:int -> int
    lo:int = 0
    hi:int = size - 1
    while lo <= hi
        mid:int = lo + (hi - lo) / 2
        if a[mid] == target
            ret mid
        elif a[mid] < target
            lo = mid + 1
        else
            hi = mid - 1
    ret -1

main
    a:int[7] = {1 3 5 7 9 11 13}
    printf("idx of 7 = %d\n", binarySearch(a, 7, 7))
    printf("idx of 8 = %d\n", binarySearch(a, 7, 8))
    ret 0
